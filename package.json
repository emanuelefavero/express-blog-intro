{
  "name": "express-blog-intro",
  "version": "1.0.0",
  "description": "<img src=\"logo.svg\" alt=\"Node.js logo\" width=\"100\">",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch app.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint",
    "preview": "npm run build:client && npm start"
  },
  "keywords": [],
  "author": "Emanuele Favero <emafaux89@gmail.com> (https://emanuelefavero.com/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
